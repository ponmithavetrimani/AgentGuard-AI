# --- FRONTEND ENVIRONMENT VARIABLES ---
# URL of the deployed FastAPI backend (used by React/Vite during compile time)
VITE_API_BASE_URL=https://agentguard-ai-api.onrender.com

# (Optional) Firebase Credentials for production Google Login.
# If left blank, the application automatically falls back to high-fidelity mock Google accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# --- BACKEND ENVIRONMENT VARIABLES ---
# Allowed CORS origins (comma-separated if multiple, e.g. https://agentguard-ai.onrender.com)
FRONTEND_URL=https://agentguard-ai.onrender.com

# Database Connection URL (SQLite for demo, PostgreSQL for production persistence)
# SQLite default: sqlite:///./agentguard.db
# PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./agentguard.db
